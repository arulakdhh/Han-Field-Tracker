rules_version = '2';
// ================================================================
//  Dr. Han Field Sales – Firestore security rules
//  Paste this whole file into: Firebase console → Firestore Database → Rules → Publish
//  Admin login email must match firebase-config.js (HAN_ADMIN_EMAIL).
//  Covers the Field Sales app AND the Implant Product Register (/inventory).
// ================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function isAdmin()  { return signedIn() && request.auth.token.email.lower() == 'admin@hanfield.app'; }
    // Executive emails look like  dhh01.3@hanfield.app  →  ID "DHH01", login generation 3
    function localPart() { return request.auth.token.email.lower().split('@')[0]; }
    function myExec()   { return localPart().split('[.]')[0].upper(); }
    function myGen()    { return int(localPart().split('[.]')[1]); }
    function authDoc(id){ return get(/databases/$(database)/documents/auth/$(id)); }
    // A valid executive = has an auth record whose generation matches this login (old logins stop working after a reset)
    function isExec(id) { return signedIn() && !isAdmin() && myExec() == id
                                 && exists(/databases/$(database)/documents/auth/$(id))
                                 && authDoc(id).data.gen == myGen(); }
    function isMember() { return isAdmin() || (signedIn() && isExec(myExec())); }

    // ---- Implant Product Register (inventory) staff: listed in inv/main/users/<email> ----
    function myEmail()  { return request.auth.token.email.lower(); }
    function invDoc()   { return get(/databases/$(database)/documents/inv/main/users/$(myEmail())); }
    function invStaff() { return signedIn() && (isAdmin() || (exists(/databases/$(database)/documents/inv/main/users/$(myEmail())) && invDoc().data.get('active', true) != false)); }
    function invAdmin() { return signedIn() && (isAdmin() || (invStaff() && invDoc().data.get('isAdmin', false) == true)); }
    function maxDisc()  { return get(/databases/$(database)/documents/config/master).data.get('quote', {}).get('maxDisc', 10); }

    // Executive IDs + names for the login screen (no passwords)
    match /public/{doc}     { allow read: if true;        allow write: if isAdmin(); }
    // Team & doctor list, team look
    match /config/{doc}     { allow read: if isMember();  allow write: if isAdmin(); }
    // Login generation per executive; an executive may only clear their own "must change password" flag
    match /auth/{id} {
      allow read:  if isAdmin() || isExec(id);
      allow write: if isAdmin();
      allow update: if isExec(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange','pwSetAt']);
    }
    // Meetups: each executive only their own folder; admin everything
    match /visits/{id} {
      allow read, write: if isAdmin() || isExec(id);
      match /v/{v}      { allow read, write: if isAdmin() || isExec(id); }
    }
    // Orders: each executive only their own folder; admin everything
    match /orders/{id} {
      allow read, write: if isAdmin() || isExec(id);
      match /o/{o}      { allow read, write: if isAdmin() || isExec(id); }
    }
    // Activity log: each user writes their own day files; admin reads all
    match /activity/{id} {
      allow read, write: if isAdmin() || isExec(id);
      match /d/{day}    { allow read, write: if isAdmin() || isExec(id); }
    }
    // Shared team data
    match /plans/{doc}      { allow read, write: if isMember(); }
    match /assign/{doc}     { allow read, write: if isMember(); }
    match /transfers/{doc}  { allow read, write: if isMember(); }
    // Doctor details updated by executives (phone, address, timings…)
    match /docinfo/{doc}    { allow read, write: if isMember(); }

    // ================= INVENTORY (Implant Product Register at /inventory) =================
    // Staff list: only inventory admins change it; everyone can read their own entry
    match /inv/main/users/{email} {
      allow read:  if invAdmin() || (signedIn() && myEmail() == email);
      allow write: if invAdmin();
    }
    // Everything else in the register: active staff only (field executives have no access)
    match /inv/main/{coll}/{doc} {
      allow read, write: if coll != 'users' && invStaff();
    }
    // Product list published by the register: MRP / GST / HSN only — no purchase rates
    match /catalog/{doc} {
      allow read:  if isMember() || invStaff();
      allow write: if invStaff();
    }
    // Field quotations: each executive creates and edits only their own; discount within the admin's limit
    match /fquotes/{id} {
      allow read:   if isAdmin() || invStaff() || (resource == null && isMember()) || (resource.data.exec == myExec() && isExec(myExec()));
      allow create: if isAdmin() || (isExec(request.resource.data.exec) && request.resource.data.discEff <= maxDisc());
      allow update: if isAdmin() || invStaff()
                    || (isExec(resource.data.exec) && request.resource.data.exec == resource.data.exec && request.resource.data.discEff <= maxDisc());
      allow delete: if isAdmin();
    }
  }
}
